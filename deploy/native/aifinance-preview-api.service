# TEMPLATE ONLY: install/enable requires separately authorized provisioning.
[Unit]
Description=AIFinance isolated preview api
After=network.target

[Service]
Type=simple
User=aifinance
Group=aifinance
ExecStart=/usr/bin/python3 -I /opt/aifinance/bin/run-preview.py api
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aifinance/shared/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# MemoryLimit is supported by systemd 239 on the target's cgroup v1 hierarchy.
MemoryAccounting=yes
MemoryLimit=320M
TasksMax=64
CPUQuota=50%
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
