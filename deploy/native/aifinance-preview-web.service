# TEMPLATE ONLY: install/enable requires separately authorized provisioning.
[Unit]
Description=AIFinance isolated preview web
After=network.target

[Service]
Type=simple
User=aifinance
Group=aifinance
ExecStart=/usr/bin/python3 -I /opt/aifinance/bin/run-preview.py web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aifinance/shared/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# Provisional low-load budget; verify actual enforcement and peak usage before native-ready.
MemoryAccounting=yes
MemoryLimit=256M
TasksMax=64
CPUQuota=50%
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
