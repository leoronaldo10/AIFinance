# TEMPLATE ONLY: install/enable requires separately authorized provisioning.
[Unit]
Description=AIFinance isolated preview web
After=network.target

[Service]
Type=simple
User=aifinance
Group=aifinance
ExecStart=/usr/bin/python3 /opt/aifinance/bin/run-preview.py web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/aifinance/shared/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
UMask=0077

[Install]
WantedBy=multi-user.target
