-- Operator cleanup after service inactive/MainPID=0. Preserve collected rows.
BEGIN;
SET LOCAL lock_timeout='3s';
SET LOCAL statement_timeout='5s';
ALTER ROLE aifinance_collect_once NOLOGIN PASSWORD NULL;
REVOKE SELECT ON TABLE public.sources FROM aifinance_collect_once;
REVOKE UPDATE (cursor, last_fetch_at, last_ok_at, health, fail_count, last_error, updated_at) ON TABLE public.sources FROM aifinance_collect_once;
REVOKE SELECT (id, source_id, identity_key, collect_only, revision, content_hash, backfill, title, body_text, excerpt, author, language, body_html, body_status, media, x_post, processing_state) ON TABLE public.articles FROM aifinance_collect_once;
REVOKE INSERT (id, source_id, identity_key, url, title, author, language, published_at, published_at_claim, discovered_at, source_updated_at, timeline_at, backfill, backfill_reason, revision, content_hash, excerpt, body_text, body_html, body_status, media, x_post, raw, collect_only, processing_state) ON TABLE public.articles FROM aifinance_collect_once;
REVOKE UPDATE (collect_only, processing_state, processing_queued_at, processing_retry_at, content_hash, excerpt, title, author, language, source_updated_at, body_text, body_html, body_status, media, x_post, revision, updated_at) ON TABLE public.articles FROM aifinance_collect_once;
REVOKE SELECT (article_id, content_hash) ON TABLE public.article_revisions FROM aifinance_collect_once;
REVOKE INSERT (article_id, revision, content_hash, title, body_text) ON TABLE public.article_revisions FROM aifinance_collect_once;
REVOKE INSERT (article_id, source_id, via, discovered_at) ON TABLE public.article_discoveries FROM aifinance_collect_once;
REVOKE INSERT (source_id, status, finished_at, found_count, new_count, error, detail) ON TABLE public.fetch_runs FROM aifinance_collect_once;
REVOKE USAGE ON SEQUENCE public.fetch_runs_id_seq FROM aifinance_collect_once;
REVOKE USAGE ON SCHEMA public FROM aifinance_collect_once;
REVOKE CONNECT ON DATABASE __DATABASE_NAME__ FROM aifinance_collect_once;
COMMIT;
