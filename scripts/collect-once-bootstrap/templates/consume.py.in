#!/usr/bin/python3
"""Root-only fixed single-use latch. No parameters, commands or remote input."""
import os,sys,stat
from pathlib import Path
os.environ.clear()
p=Path('/var/lib/aifinance-collect-once')
try:
 assert os.geteuid()==0 and len(sys.argv)==1
 for q in (p,*p.parents):
  s=q.lstat();assert stat.S_ISDIR(s.st_mode) and s.st_uid==0 and not s.st_mode&0o022
 # Installation must provide a root-owned 0600 ready receipt only after all gates.
 a=p/'ready';s=a.lstat();assert stat.S_ISREG(s.st_mode) and s.st_uid==0 and stat.S_IMODE(s.st_mode)==0o600 and s.st_nlink==1
 assert a.read_text()=='d57ba047369e666025347719caee1a4c642abe62\n'
 fd=os.open(str(p/'consumed'),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
 os.write(fd,b'one attempt consumed; failures require separate approval\n');os.fsync(fd);os.close(fd)
except Exception:sys.exit(1)
