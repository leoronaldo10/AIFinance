SELECT
 (SELECT NOT rolcanlogin AND rolpassword IS NULL FROM pg_authid WHERE rolname='aifinance_collect_once')
 AND NOT EXISTS(SELECT 1 FROM pg_stat_activity WHERE usename='aifinance_collect_once')
 AND NOT EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
   WHERE n.nspname='public' AND c.relname IN ('sources','articles','article_revisions','article_discoveries','fetch_runs')
   AND (has_table_privilege('aifinance_collect_once',c.oid,'SELECT,INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
     OR has_any_column_privilege('aifinance_collect_once',c.oid,'SELECT,INSERT,UPDATE,REFERENCES')))
 AND NOT has_sequence_privilege('aifinance_collect_once','public.fetch_runs_id_seq','USAGE,SELECT,UPDATE')
 AND NOT EXISTS(SELECT 1 FROM pg_database d CROSS JOIN LATERAL aclexplode(d.datacl) a JOIN pg_roles r ON r.oid=a.grantee WHERE d.datname=current_database() AND r.rolname='aifinance_collect_once')
 AND NOT EXISTS(SELECT 1 FROM pg_namespace n CROSS JOIN LATERAL aclexplode(n.nspacl) a JOIN pg_roles r ON r.oid=a.grantee WHERE n.nspname='public' AND r.rolname='aifinance_collect_once');
