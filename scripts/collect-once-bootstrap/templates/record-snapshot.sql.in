SELECT jsonb_build_object(
'articles', (SELECT coalesce(jsonb_object_agg(t.id::text,jsonb_build_object('hash',md5(to_jsonb(t)::text),'valid',coalesce((t.collect_only AND t.processing_state='skipped' AND t.processing_queued_at IS NULL AND t.processing_retry_at IS NULL AND coalesce(length(t.body_text),0)<=2000 AND coalesce(length(t.excerpt),0)<=2000 AND t.source_id IN ('collect-dynamics-finance','collect-journal-accountancy','collect-accounting-today')),false))),'{}'::jsonb) FROM public.articles t),
'article_revisions', (SELECT coalesce(jsonb_object_agg(jsonb_build_array(t.article_id,t.revision)::text,jsonb_build_object('hash',md5(to_jsonb(t)::text),'valid',coalesce((coalesce(length(t.body_text),0)<=2000 AND EXISTS(SELECT 1 FROM articles a WHERE a.id=t.article_id AND a.collect_only AND a.processing_state='skipped' AND a.source_id IN ('collect-dynamics-finance','collect-journal-accountancy','collect-accounting-today'))),false))),'{}'::jsonb) FROM public.article_revisions t),
'article_discoveries', (SELECT coalesce(jsonb_object_agg(jsonb_build_array(t.article_id,t.source_id,t.via)::text,jsonb_build_object('hash',md5(to_jsonb(t)::text),'valid',coalesce((t.source_id IN ('collect-dynamics-finance','collect-journal-accountancy','collect-accounting-today') AND EXISTS(SELECT 1 FROM articles a WHERE a.id=t.article_id AND a.collect_only AND a.processing_state='skipped')),false))),'{}'::jsonb) FROM public.article_discoveries t),
'fetch_runs', (SELECT coalesce(jsonb_object_agg(t.id::text,jsonb_build_object('hash',md5(to_jsonb(t)::text),'valid',coalesce((t.source_id IN ('collect-dynamics-finance','collect-journal-accountancy','collect-accounting-today')),false))),'{}'::jsonb) FROM public.fetch_runs t),
'sources', (SELECT coalesce(jsonb_object_agg(t.id::text,jsonb_build_object('hash',md5(to_jsonb(t)::text),'valid',coalesce((t.id IN ('collect-dynamics-finance','collect-journal-accountancy','collect-accounting-today') AND NOT t.enabled AND t.collect_only AND t.participation_mode='isolated' AND NOT t.site_fulltext AND NOT t.syndicate_fulltext AND ((t.id='collect-dynamics-finance' AND t.config=jsonb_build_object('feedUrl','https://www.microsoft.com/en-us/dynamics-365/blog/product/dynamics-365-finance/feed/')) OR (t.id='collect-journal-accountancy' AND t.config=jsonb_build_object('feedUrl','https://www.journalofaccountancy.com/news/feed/')) OR (t.id='collect-accounting-today' AND t.config=jsonb_build_object('feedUrl','https://www.accountingtoday.com/feed?rss=true')))),false))),'{}'::jsonb) FROM public.sources t));
