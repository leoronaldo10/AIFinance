[Unit]
Description=Passive fixed-unit collection status observation
After=dbus.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=aifinance_editor
Group=aifinance_editor
ExecStart=/usr/bin/python3 -I -B -S /opt/aifinance-collection-observer/observe.py
RuntimeDirectory=aifinance-collection-observer
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
ReadWritePaths=/run/aifinance-collection-observer

[Install]
WantedBy=multi-user.target
